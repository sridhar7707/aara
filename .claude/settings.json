{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/session_health.py\"",
            "shell": "bash",
            "timeout": 150,
            "statusMessage": "Checking health (runs weekly, cached otherwise)..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/decision_gate.py\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Loading decision rule..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/bash_gate.py\" commit_post",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Running post-commit lint and review checks..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/edit_guard.py\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking edit (syntax, file size, tests, decision log)..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/edit_guard.py\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking frozen-path rules..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/bash_gate.py\" commit_pre",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Updating REQUIREMENTS.md before commit..."
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/bash_gate.py\" push_pre",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Running arch + standards review before push..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
