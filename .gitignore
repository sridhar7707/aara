# Auto-generated requirement snapshot backups (req_state.json is the source of truth)
tests/req_snapshots/req_2*.json

# DuckDB generated database file (created at runtime)
database/duckdb/*.duckdb

# Playwright UI-check screenshots (tests/check_ui.py) — local dev artifacts only
tests/snapshots/playwright/

# Playwright MCP browser-automation scratch directory (ad hoc browser tool
# output — traces/snapshots from interactive review sessions, not source)
.playwright-mcp/

# HuggingFace model download cache (temp directory, not source-controlled)
models/hf_fresh/

# Local-only planning doc (user's working plan — not for GitHub)
docs/PHASE_PLAN_decision_intelligence.md

# Architecture docs — kept local only, stripped from GitHub history 2026-07-29
